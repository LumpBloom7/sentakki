{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "osu.Game.Rulesets.Sentakki.Tests",
                "/p:Configuration=Debug",
                "/m",
                "/verbosity:m"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        // Test Tasks
        {
            "label": "Run tests",
            "type": "process",
            "command": "dotnet",
            "args": [
                "test",
                "/p:Configuration=Debug",
            ],
            "group": "test",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Restore tools",
            "type": "process",
            "command": "dotnet",
            "args": [
                "tool",
                "restore"
            ],
            "group": "none",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run resharper code cleanup",
            "type": "process",
            "command": "dotnet",
            "args": [
                "tool",
                "run",
                "jb",
                "cleanupcode",
                "osu.Game.Rulesets.Sentakki.sln",
                "--profile=Built-in: Reformat Code"
            ],
            "dependsOn": "Restore tools",
            "group": "none",
            "problemMatcher": "$msCompile"
        },
    ]
}